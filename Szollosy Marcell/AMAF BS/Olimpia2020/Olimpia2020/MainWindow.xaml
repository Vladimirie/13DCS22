<Window x:Class="Olimpia2020.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Olimpia2020"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <ListBox x:Name="lbOrszagok" Margin="10" SelectionChanged="lbOrszagok_SelectionChanged" Grid.Column="0"/>
        <StackPanel Orientation="Vertical" Margin="10" Grid.Column="1">
            <StackPanel Orientation="Horizontal" Margin="5" >
                <Label Content="Aranyérmek száma:"/>
                <TextBox x:Name="txtArany" Margin="5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5" >
                <Label Content="Ezüstérmék száma:"/>
                <TextBox x:Name="txtEzust" Margin="5" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5" >
                <Label Content="Bronzérmek száma:"/>
                <TextBox x:Name="txtBronz" Margin="5" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
