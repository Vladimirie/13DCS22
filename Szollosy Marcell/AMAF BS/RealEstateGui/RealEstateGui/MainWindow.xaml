<Window x:Class="RealEstateGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingatlanok" Height="400" Width="600">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="listBoxSellers"
                 DisplayMemberPath="Name" />

        <StackPanel Grid.Column="1" Margin="20,0,0,0">

            <TextBlock Text="Eladó neve:" FontWeight="Bold"/>
            <Label Content="{Binding SelectedItem.Name, ElementName=listBoxSellers}" />

            <TextBlock Text="Eladó telefonszáma:" FontWeight="Bold" Margin="0,10,0,0"/>
            <Label Content="{Binding SelectedItem.Phone, ElementName=listBoxSellers}" />

            <Button Content="Hirdetések betöltése"
                    Click="BtnLoadAds_Click"
                    Margin="0,20,0,0"/>

            <TextBlock Text="Hirdetések száma:" FontWeight="Bold" Margin="0,10,0,0"/>
            <Label x:Name="lblAdCount"/>
        </StackPanel>
    </Grid>
</Window>