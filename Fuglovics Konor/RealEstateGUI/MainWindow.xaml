<Window x:Class="RealEstateGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RealEstateGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.3*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<ListBox x:Name="sellerlist" FontSize="11px" FontFamily="Microsoft Sans Serif" TextOptions.TextFormattingMode="Display" Margin="10" SelectionChanged="sellerlist_SelectionChanged" DisplayMemberPath="Name"/>
		<Grid Grid.Column="1" Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="0.125*"/>
				<RowDefinition Height="0.125*"/>
				<RowDefinition Height="0.125*"/>
				<RowDefinition Height="0.125*"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="textsellername" Text="Seller's Name:" VerticalAlignment="Center" />
			<TextBlock Grid.Column="1" Text="" VerticalAlignment="Center"/>
			<TextBlock x:Name="textsellerphone" Grid.Row="1" Text="Seller's Phone:" VerticalAlignment="Center" />
			<TextBlock Grid.Row="1" Grid.Column="1" Text="" VerticalAlignment="Center"/>
			<Button Grid.Row="2" Grid.ColumnSpan="2" Content="Load advertizements" Margin="15,0" Height="24" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="LoadAds"/>
			<StackPanel Grid.Row="3" VerticalAlignment="Center" Orientation="Horizontal">
				<TextBlock Text="Number of advertizements:" Margin="10,0"/>
				<TextBlock x:Name="textadverts" Text=""/>
			</StackPanel>
		</Grid>
	</Grid>
</Window>
