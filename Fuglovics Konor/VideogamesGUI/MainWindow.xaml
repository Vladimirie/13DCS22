<Window x:Class="VideogamesGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideogamesGUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="6*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="1.5*"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		<ListBox x:Name="games" DisplayMemberPath="Name" TextOptions.TextFormattingMode="Display" FontSize="11px" TextOptions.TextRenderingMode="Aliased" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Center" Height="320" Margin="0,0,0,0" VerticalAlignment="Center" Width="400" SelectionChanged="ListBox_SelectionChanged"/>
		<Label Grid.Column="1" Content="Label" HorizontalAlignment="Left" Height="32" Margin="25,26,0,0" VerticalAlignment="Top" Width="102"/>

	</Grid>
</Window>
