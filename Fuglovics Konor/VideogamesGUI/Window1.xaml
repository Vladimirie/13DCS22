<Window x:Class="VideogamesGUI.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideogamesGUI"
        mc:Ignorable="d"
        Title="Keresés" Height="400" Width="600" ResizeMode="NoResize">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="0.2*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<ListBox Grid.Row="1" x:Name="searchresult" DisplayMemberPath="Name" TextOptions.TextFormattingMode="Display" FontSize="11px" TextOptions.TextRenderingMode="Aliased" FontFamily="Microsoft Sans Serif" Padding="300,150" Margin="16,0,16,16" HorizontalAlignment="Center" VerticalAlignment="Center"/>

		<ComboBox HorizontalAlignment="Left" Height="21" Margin="56,0,0,0" VerticalAlignment="Center" Width="250" SelectionChanged="FilterPub"/>
		<ComboBox HorizontalAlignment="Right" Height="21" Margin="0,0,100,0" VerticalAlignment="Center" Width="128" SelectionChanged="FilterGenre"/>
		<Label Content="Kiadó:" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Height="24" Margin="4,0,0,4" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="50"/>
		<Label Content="Műfaj:" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Height="24" Margin="0,0,230,4" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="50"/>
		<Button Content="Indítás!" HorizontalAlignment="Right" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" Width="64" Click="Search"/>
	</Grid>
</Window>
