<Window x:Class="Olimpia2020GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Olimpia2020GUI"
        mc:Ignorable="d"
        Title="MainWindow" Height="320" Width="480" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.75*"/>
			<ColumnDefinition/>
		</Grid.ColumnDefinitions>
		<ListBox x:Name="országok" DisplayMemberPath="Ország" TextOptions.TextFormattingMode="Display" FontFamily="Microsoft Sans Serif" FontSize="11" Margin="10" SelectionChanged="országok_kiválasztva"/>
		<StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,48" Width="250" HorizontalAlignment="Center">
			<StackPanel Orientation="Horizontal">
				<Label Content="Aranyérmek:"/>
				<Label x:Name="arany"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<Label Content="Ezüstérmek:"/>
				<Label x:Name="ezüst"/>
			</StackPanel>
			<StackPanel Orientation="Horizontal">
				<Label Content="Bronzérmek:"/>
				<Label x:Name="bronz"/>
			</StackPanel>
			<Button Height="24" Margin="0,12,0,0" Width="128" Content="Magyarország érmei" Click="Magyar_érmek"/>
			<StackPanel Orientation="Vertical" Margin="0,10,0,0" x:Name="hundata">
				<StackPanel Orientation="Horizontal">
					<Label Content="Arany:"/>
					<Label x:Name="hunarany"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Label Content="Ezüst:"/>
					<Label x:Name="hunezüst"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal">
					<Label Content="Bronz:"/>
					<Label x:Name="hunbronz"/>
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</Grid>
</Window>
