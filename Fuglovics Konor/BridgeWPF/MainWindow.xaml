<Window x:Class="BridgeWPF.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:BridgeWPF"
		mc:Ignorable="d"
		Title="Bridges" Height="600" Width="500">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Menu Grid.Row="0">
			<MenuItem Header="File">
				<MenuItem Name="open" Header="Open" Click="Open"/>
			</MenuItem>
			<MenuItem Name="search" Header="Search" Click="Search"/>
			<MenuItem Name="quit" Header="Quit" Click="Quit"/>
		</Menu>
		<Grid Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="1.5*"/>
				<RowDefinition Height="1*"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<ListBox DisplayMemberPath="Name" x:Name="listbridge" Width="250" Height="300"/>
			<TextBlock Grid.Column="1" Height="24" Width="50" Text="Helyszín:" Margin="0,32,160,0" VerticalAlignment="Top" TextAlignment="Right"/>
			<Label Grid.Column="1" x:Name="pos" Height="32" Width="140" Margin="50,32,0,0" VerticalAlignment="Top"/>
			<TextBlock Grid.Column="1" Height="24" Width="50" Text="Ország:" Margin="0,64,160,0" VerticalAlignment="Top" TextAlignment="Right"/>
			<Label Grid.Column="1" x:Name="country" Height="32" Width="140" Margin="50,64,0,0" VerticalAlignment="Top"/>
			<TextBlock Grid.Column="1" Height="24" Width="50" Text="Hossz:" Margin="0,96,160,0" VerticalAlignment="Top" TextAlignment="Right"/>
			<Label Grid.Column="1" x:Name="len" Height="32" Width="140" Margin="50,96,0,0" VerticalAlignment="Top"/>
			<TextBlock Grid.Column="1" Height="24" Width="50" Text="Év:" Margin="0,128,160,0" VerticalAlignment="Top" TextAlignment="Right"/>
			<Label Grid.Column="1" x:Name="year" Height="32" Width="140" Margin="50,128,0,0" VerticalAlignment="Top"/>
			<GroupBox Grid.Row="1" Header="Bridge filtering" Name="grp" Width="Auto" Height="Auto" Margin="20,50">
				<StackPanel Orientation="Vertical" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center">
					<RadioButton x:Name="rad_before2k" Checked="rad_before2k_isChecked">Built before 2K</RadioButton>
					<RadioButton x:Name="rad_after2K" Checked="rad_after2k_isChecked">Built in 2000 and after 2K</RadioButton>
					<StackPanel Orientation="Horizontal" Margin="0,10">
						<TextBlock Text="Amount:"/>
						<TextBox Name="amt" Width="156"/>
					</StackPanel>
				</StackPanel>
			</GroupBox>
			<Button Grid.Row="1" Grid.Column="1" Width="75" Height="24" Content="Quit" Click="Quit" />
		</Grid>
	</Grid>
</Window>
