<Window x:Class="Fuggohidak.KeresesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keresés ország szerint" Height="400" Width="400">

    <StackPanel Margin="20">

        <TextBlock Text="Válassz országot:"/>
        <ComboBox x:Name="cbOrszag"
                  Margin="0,5,0,10"
                  Width="200"/>

        <Button Content="Keresés"
                Width="100"
                Click="Kereses_Click"/>

        <TextBox x:Name="txtEredmeny"
                 Margin="0,20,0,0"
                 Height="200"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <Button Content="Bezárás"
                Margin="0,10,0,0"
                Width="100"
                Click="Bezaras_Click"/>
    </StackPanel>
</Window>
